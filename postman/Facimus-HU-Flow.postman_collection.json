							"type": "text/javascript",
							"exec": [
								"pm.test('Status 200', () => pm.response.to.have.status(200));",
								"pm.test('Usuario desactivado', () => {",
								"  pm.expect(pm.response.json().activo).to.be.false;",
								"});"
							]
						}
					}],
					"request": {
						"method": "PATCH",
						"header": [{"key": "Content-Type", "value": "application/json"}],
						"body": {
							"mode": "raw",
							"raw": "{\"activo\": false}"
						},
						"url": "{{baseUrl}}/api/v1/usuarios/{{lectorId}}"
					}
				},
				{
					"name": "Reactivar usuario lector",
					"event": [{
						"listen": "test",
						"script": {
							"type": "text/javascript",
							"exec": [
