		{
			"name": "06 — Pools (HU-21)",
			"item": [
				{
					"name": "Listar pools (obtener el auto-creado)",
					"event": [{
						"listen": "test",
						"script": {
							"type": "text/javascript",
							"exec": [
								"pm.test('Status 200', () => pm.response.to.have.status(200));",
								"const pools = pm.response.json();",
