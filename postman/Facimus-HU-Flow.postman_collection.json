{
	"info": {
		"name": "Facimus Procesos — Flujo de pruebas HU",
		"description": "Simula un flujo real completo que recorre las 28 historias de usuario.\n\nCada request extrae datos (IDs, tokens) y los pasa a las siguientes mediante variables de coleccion. Ejecutar con el **Collection Runner** en orden secuencial.\n\n**Prerequisito:** la aplicacion debe estar corriendo en localhost:8080.\n\n**Escenario:** Una empresa se registra, su admin configura usuarios y roles, diseña un proceso BPMN con pools, lanes, actividades, gateways, arcos y mensajes inter-pool, lo publica, y se verifican los permisos de acceso por rol.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"auth": {
		"type": "bearer",
		"bearer": [{"key": "token", "value": "{{token}}"}]
	},
	"variable": [
		{"key": "baseUrl", "value": "http://localhost:8080"},
		{"key": "token", "value": ""},
		{"key": "runId", "value": ""},
		{"key": "adminEmail", "value": ""},
		{"key": "adminPassword", "value": "Admin123!"},
		{"key": "editorEmail", "value": ""},
		{"key": "editorPassword", "value": "Editor123!"},
		{"key": "lectorEmail", "value": ""},
		{"key": "lectorPassword", "value": "Lector123!"},
		{"key": "nit", "value": ""},
		{"key": "procesoId", "value": ""},
		{"key": "pool1Id", "value": ""},
		{"key": "pool2Id", "value": ""},
		{"key": "rolAnalistaId", "value": ""},
		{"key": "rolGerenteId", "value": ""},
		{"key": "rolTempId", "value": ""},
		{"key": "lane1Id", "value": ""},
		{"key": "lane2Id", "value": ""},
		{"key": "lane3Id", "value": ""},
		{"key": "act1Id", "value": ""},
		{"key": "act2Id", "value": ""},
		{"key": "act3Id", "value": ""},
		{"key": "gatewayId", "value": ""},
		{"key": "gatewayParaleloId", "value": ""},
		{"key": "arco1Id", "value": ""},
		{"key": "arco2Id", "value": ""},
		{"key": "arco3Id", "value": ""},
		{"key": "eventoThrow1Id", "value": ""},
		{"key": "eventoThrow2Id", "value": ""},
		{"key": "mensaje1Id", "value": ""},
		{"key": "mensaje2Id", "value": ""},
		{"key": "editorId", "value": ""},
		{"key": "lectorId", "value": ""}
	],
	"item": [
		{
			"name": "01 — Registro de empresa (HU-01)",
			"item": [
				{
					"name": "Registrar empresa nueva",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"type": "text/javascript",
								"exec": [
									"const id = Date.now().toString().slice(-10) + Math.floor(Math.random() * 100).toString().padStart(2, '0');",
									"pm.collectionVariables.set('runId', id);",
									"pm.collectionVariables.set('nit', 'TEST' + id + '-1');",
									"pm.collectionVariables.set('adminEmail', 'admin.' + id + '@test.com');",
									"pm.collectionVariables.set('editorEmail', 'editor.' + id + '@test.com');",
									"pm.collectionVariables.set('lectorEmail', 'lector.' + id + '@test.com');"
								]
							}
						},
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Empresa creada (201)', () => pm.response.to.have.status(201));",
									"const json = pm.response.json();",
									"pm.test('Tiene ID', () => pm.expect(json.id).to.be.a('number'));",
									"pm.test('NIT generado correctamente', () => pm.expect(json.nit).to.eql(pm.collectionVariables.get('nit')));",
									"pm.test('Tiene fecha de registro', () => pm.expect(json.fechaRegistro).to.be.a('string'));"
								]
							}
						}
					],
					"request": {
						"auth": {"type": "noauth"},
						"method": "POST",
						"header": [{"key": "Content-Type", "value": "application/json"}],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"nombreEmpresa\": \"QA Lab {{runId}}\",\n  \"nit\": \"{{nit}}\",\n  \"correoContacto\": \"contacto.{{runId}}@test.com\",\n  \"nombreAdmin\": \"Admin Pruebas\",\n  \"emailAdmin\": \"{{adminEmail}}\",\n  \"passwordAdmin\": \"{{adminPassword}}\"\n}"
						},
						"url": "{{baseUrl}}/api/v1/empresas"
					}
				},
				{
					"name": "Registrar con NIT duplicado falla",
					"event": [{
						"listen": "test",
						"script": {
							"type": "text/javascript",
							"exec": [
								"pm.test('NIT duplicado rechazado (409 o 400)', () => {",
								"  pm.expect(pm.response.code).to.be.oneOf([400, 409]);",
								"});"
							]
						}
					}],
					"request": {
						"auth": {"type": "noauth"},
						"method": "POST",
						"header": [{"key": "Content-Type", "value": "application/json"}],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"nombreEmpresa\": \"Duplicada\",\n  \"nit\": \"{{nit}}\",\n  \"correoContacto\": \"dup@test.com\",\n  \"nombreAdmin\": \"Admin\",\n  \"emailAdmin\": \"dup@test.com\",\n  \"passwordAdmin\": \"Test123!\"\n}"
						},
						"url": "{{baseUrl}}/api/v1/empresas"
					}
				}
			]
		},
		{
			"name": "02 — Autenticacion (HU-03)",
			"item": [
				{
					"name": "Login con credenciales correctas",
					"event": [{
						"listen": "test",
						"script": {
							"type": "text/javascript",
							"exec": [
								"pm.test('Login exitoso (200)', () => pm.response.to.have.status(200));",
								"const json = pm.response.json();",
								"pm.test('Retorna accessToken', () => pm.expect(json.accessToken).to.be.a('string'));",
								"pm.test('Token type es Bearer', () => pm.expect(json.tokenType).to.eql('Bearer'));",
								"pm.collectionVariables.set('token', json.accessToken);"
							]
						}
					}],
					"request": {
						"auth": {"type": "noauth"},
						"method": "POST",
						"header": [{"key": "Content-Type", "value": "application/json"}],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
						},
						"url": "{{baseUrl}}/api/v1/auth/login"
					}
				},
				{
					"name": "Login con clave incorrecta falla",
					"event": [{
						"listen": "test",
						"script": {
							"type": "text/javascript",
							"exec": [
								"pm.test('Clave incorrecta (401)', () => pm.response.to.have.status(401));"
							]
						}
					}],
					"request": {
						"auth": {"type": "noauth"},
						"method": "POST",
						"header": [{"key": "Content-Type", "value": "application/json"}],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"clave-mala\"\n}"
						},
						"url": "{{baseUrl}}/api/v1/auth/login"
					}
				},
				{
					"name": "Endpoint protegido sin token falla",
					"event": [{
						"listen": "test",
						"script": {
							"type": "text/javascript",
							"exec": [
								"pm.test('Sin token (401)', () => pm.response.to.have.status(401));",
								"pm.test('ProblemDetail con titulo', () => {",
								"  pm.expect(pm.response.json().title).to.eql('No autenticado');",
								"});"
							]
						}
					}],
					"request": {
						"auth": {"type": "noauth"},
						"method": "GET",
						"url": "{{baseUrl}}/api/v1/procesos"
					}
				}
			]
		},
		{
