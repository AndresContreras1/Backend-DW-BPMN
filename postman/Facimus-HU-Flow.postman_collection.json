								"const json = pm.response.json();",
								"pm.test('Rol es SOLO_LECTURA', () => pm.expect(json.rolAcceso).to.eql('SOLO_LECTURA'));",
								"pm.collectionVariables.set('lectorId', json.id);"
							]
						}
					}],
					"request": {
						"method": "POST",
						"header": [{"key": "Content-Type", "value": "application/json"}],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"nombre\": \"Lector Pruebas\",\n  \"email\": \"{{lectorEmail}}\",\n  \"password\": \"{{lectorPassword}}\",\n  \"rolAcceso\": \"SOLO_LECTURA\"\n}"
						},
						"url": "{{baseUrl}}/api/v1/usuarios"
					}
