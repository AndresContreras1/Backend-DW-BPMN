					"event": [{
						"listen": "test",
						"script": {
							"type": "text/javascript",
							"exec": [
								"pm.test('Status 200', () => pm.response.to.have.status(200));",
								"pm.test('Email correcto', () => {",
								"  pm.expect(pm.response.json().email).to.eql(pm.collectionVariables.get('editorEmail'));",
								"});"
							]
						}
					}],
					"request": {
						"method": "GET",
						"url": "{{baseUrl}}/api/v1/usuarios/{{editorId}}"
					}
				},
