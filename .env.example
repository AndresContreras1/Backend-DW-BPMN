# Copie este archivo como .env y complete los valores. El archivo .env no se versiona.
DB_NAME=procesos
DB_USER=procesos
DB_PASSWORD=
# Clave para firmar los tokens JWT: minimo 32 caracteres, aleatoria y propia de cada entorno.
JWT_SECRET=
# Origenes del frontend permitidos por CORS, separados por coma.
CORS_ALLOWED_ORIGINS=http://localhost:4200
