        <!-- 10. Crear arco: actividad 1 -> gateway -->
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="POST /api/v1/arcos - Arco act1 a gateway" enabled="true">
