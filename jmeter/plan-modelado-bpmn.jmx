        <!-- 7. Crear actividad 1 en lane -->
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="POST /api/v1/lanes/{id}/actividades - Crear actividad 1" enabled="true">
          <stringProp name="HTTPSampler.domain">${BASE_URL}</stringProp>
