        <!-- 9. Crear gateway exclusivo -->
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="POST /api/v1/lanes/{id}/gateways - Crear gateway" enabled="true">
